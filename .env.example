# local graph (docker, scripts/hydradb-local.sh)
HYDRA_BOLT_URI=bolt://127.0.0.1:7687
HYDRA_BOLT_TOKEN=local-development-token-32-bytes

# hydradb cloud, for the hybrid vectorstore. get one at app.hydradb.com
HYDRA_DB_API_KEY=

# any one of these works, first found wins
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# free at build.nvidia.com, starts with nvapi-
NVIDIA_API_KEY=

# below this score the agent refuses to answer
ENGRAM_ABSTAIN_THRESHOLD=0.55
